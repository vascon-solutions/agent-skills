# S3 destination
ARTIFACTS_S3_BUCKET=
ARTIFACTS_S3_REGION=
ARTIFACTS_S3_PREFIX=
AWS_PROFILE=artifacts

# Keep AWS keys out of repo-local env files. Store credentials in an
# AWS profile, SSO, IAM role, or one-off shell environment instead.

# Compatibility aliases if copying values from another S3 config.
# Canonical values above win when both are set. Do not store credential
# aliases in skills/publish-artifact/.env.
# S3_BUCKET_NAME -> ARTIFACTS_S3_BUCKET
# S3_REGION -> ARTIFACTS_S3_REGION
# S3_ACCESS_KEY_ID -> AWS_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY -> AWS_SECRET_ACCESS_KEY
# S3_BASE_URL is not used.

# Wiki destination uses gh / git; no env vars needed.

# ClickUp destination
CLICKUP_API_TOKEN=
CLICKUP_PARENT_TYPE=
CLICKUP_PARENT_ID=
# Required only when --clickup-parent is not workspace:<id>.
CLICKUP_WORKSPACE_ID=

# Google Docs / Drive destination
GOOGLE_DRIVE_PARENT_ID=
# GOOGLE_APPLICATION_CREDENTIALS is a path to a service-account JSON.
# Never put the credential bytes themselves in this file. The path must
# resolve outside this repo and outside any agent-artifacts workspace.
GOOGLE_APPLICATION_CREDENTIALS=
