ARTIFACTS_S3_BUCKET=
ARTIFACTS_S3_REGION=
ARTIFACTS_S3_PREFIX=
AWS_PROFILE=artifacts

# Keep AWS keys out of repo-local env files. Store credentials in an
# AWS profile, SSO, IAM role, or one-off shell environment instead.

# Compatibility aliases if copying values from another S3 config.
# Canonical values above win when both are set. Do not store credential
# aliases in skills/publish-artifact/.env.
# S3_BUCKET_NAME -> ARTIFACTS_S3_BUCKET
# S3_REGION -> ARTIFACTS_S3_REGION
# S3_ACCESS_KEY_ID -> AWS_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY -> AWS_SECRET_ACCESS_KEY
# S3_BASE_URL is not used.
