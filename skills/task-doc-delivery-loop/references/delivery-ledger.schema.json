{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vascon-solutions/agent-skills/skills/task-doc-delivery-loop/references/delivery-ledger.schema.json",
  "title": "Delivery ledger, schema_version 1",
  "description": "Structure only. The helper (scripts/delivery-ledger.mjs) validates every document against this file and additionally enforces the transition and external-identity invariants in delivery-ledger.md. Unknown fields are preserved but never interpreted.",
  "type": "object",
  "required": [
    "schema_version", "delivery_id", "revision", "created_at", "updated_at", "repo", "sources", "authorization",
    "phase", "checkpoint", "owner", "next", "blocker", "completion", "policy", "candidate", "validation", "audits",
    "reviews", "defect_shapes", "publications", "role_runs", "sessions", "limitations", "history", "audit_policy",
    "review_bound", "pr", "measurements", "updated_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "delivery_id": { "$ref": "#/$defs/Uuid" },
    "revision": { "$ref": "#/$defs/Counter" },
    "created_at": { "$ref": "#/$defs/Timestamp" },
    "updated_at": { "$ref": "#/$defs/Timestamp" },
    "repo": { "$ref": "#/$defs/Repo" },
    "sources": { "$ref": "#/$defs/Sources" },
    "authorization": { "$ref": "#/$defs/AuthorizationObject" },
    "phase": { "enum": ["delivery", "review_round", "watch", "done", "blocked"] },
    "checkpoint": { "$ref": "#/$defs/Checkpoint" },
    "owner": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Owner" }] },
    "next": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Next" }] },
    "blocker": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Blocker" }] },
    "completion": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Completion" }] },
    "policy": { "$ref": "#/$defs/Policy" },
    "candidate": { "$ref": "#/$defs/Candidate" },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/Validation" } },
    "audits": { "type": "array", "items": { "$ref": "#/$defs/Audit" } },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/Review" } },
    "defect_shapes": { "type": "array", "items": { "$ref": "#/$defs/DefectShape" } },
    "publications": { "type": "array", "items": { "$ref": "#/$defs/PublicationEvent" } },
    "role_runs": { "type": "array", "items": { "$ref": "#/$defs/RoleRun" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/Session" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/Limitation" } },
    "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/HistoryEvent" } },
    "audit_policy": { "$ref": "#/$defs/AuditPolicy" },
    "review_bound": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ReviewBound"}], "description": "Null until the provisional estimate is finalized on a frozen candidate; legacy/local-only records remain readable."},
    "pr": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/PR" }] },
    "measurements": { "$ref": "#/$defs/Measurements" },
    "updated_by": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/UpdatedBy" }] }
  },
  "$defs": {
    "ReviewBoundBasis": {
      "type": "object",
      "required": [
        "files",
        "packages",
        "workspace_decision",
        "delegated_decision"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/Counter"
        },
        "packages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/StringArray"
            }
          ]
        },
        "workspace_decision": {
          "$ref": "#/$defs/Id"
        },
        "delegated_decision": {
          "$ref": "#/$defs/NullableText"
        }
      },
      "additionalProperties": false
    },
    "ReviewBound": {
      "type": "object",
      "required": [
        "max_rounds",
        "rounds_used",
        "size",
        "measured_oid",
        "basis",
        "delegated_limit",
        "delegated_used",
        "extension_rounds",
        "overrides"
      ],
      "properties": {
        "max_rounds": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "rounds_used": {
          "$ref": "#/$defs/Counter"
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large",
            "size_unknown"
          ]
        },
        "measured_oid": {
          "$ref": "#/$defs/OID"
        },
        "basis": {
          "$ref": "#/$defs/ReviewBoundBasis"
        },
        "delegated_limit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Counter"
            }
          ]
        },
        "delegated_used": {
          "$ref": "#/$defs/Counter"
        },
        "extension_rounds": {
          "$ref": "#/$defs/Counter"
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Grant"
          }
        }
      },
      "additionalProperties": false
    },

    "Uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "Id": { "type": "string", "minLength": 1 },
    "Text": { "type": "string" },
    "NonEmptyText": { "type": "string", "minLength": 1 },
    "NullableText": { "type": ["string", "null"] },
    "Counter": { "type": "integer", "minimum": 0 },
    "PositiveInteger": { "type": "integer", "minimum": 1 },
    "Timestamp": { "type": "string", "format": "date-time" },
    "NullableTimestamp": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Timestamp" }] },
    "OID": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "NullableOID": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/OID" }] },
    "SHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "NullableSHA256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/SHA256" }] },
    "AbsolutePath": { "type": "string", "format": "absolute-path" },
    "ContentId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "NullableContentId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ContentId" }] },
    "QualifiedRef": { "type": "string", "pattern": "^(?:validation|audits|reviews|publications|role_runs|sessions):.+$" },
    "Runtime": { "enum": ["claude", "codex", "gemini"] },
    "NullableRuntime": { "enum": ["claude", "codex", "gemini", null] },
    "SessionPhase": { "enum": ["delivery", "review_round", "watch"] },
    "Endpoint": { "enum": ["local", "commit", "push", "draft_pr", "ready_pr"] },
    "Checkpoint": { "enum": ["bootstrap", "implement", "validate", "audit", "review", "publish", null] },
    "Severity": { "enum": ["critical", "important", "minor"] },
    "StringArray": { "type": "array", "items": { "type": "string" } },
    "Source": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/AbsolutePath" }, "sha256": { "$ref": "#/$defs/SHA256" } }
    },
    "NullableSource": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Source" }] },
    "SourceArray": { "type": "array", "items": { "$ref": "#/$defs/Source" } },
    "Decision": {
      "type": "object",
      "required": ["id", "text", "source"],
      "properties": { "id": { "$ref": "#/$defs/Id" }, "text": { "$ref": "#/$defs/NonEmptyText" }, "source": { "$ref": "#/$defs/NonEmptyText" } }
    },
    "SpecCheck": {
      "type": "object",
      "required": ["verdict", "report", "source_hashes", "checked_at", "reason"],
      "properties": {
        "verdict": { "enum": ["not_run", "accept", "revise", "split", "rewrite", "skipped"] },
        "report": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/AbsolutePath" }] },
        "source_hashes": { "$ref": "#/$defs/SourceArray" },
        "checked_at": { "$ref": "#/$defs/NullableTimestamp" },
        "reason": { "$ref": "#/$defs/NullableText" }
      }
    },
    "Sources": {
      "type": "object",
      "required": ["task_docs", "specs", "instructions", "decisions", "spec_check"],
      "properties": {
        "task_docs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Source" } },
        "specs": { "$ref": "#/$defs/SourceArray" },
        "instructions": { "$ref": "#/$defs/SourceArray" },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/Decision" } },
        "spec_check": { "$ref": "#/$defs/SpecCheck" }
      }
    },
    "Grant": {
      "type": "object",
      "required": ["id", "scope", "endpoint", "wording", "source", "at", "additional_cycles"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "scope": { "enum": ["endpoint", "review_round", "review_waiver", "monitor_observe", "monitor_remediate", "merge", "takeover", "reconcile"] },
        "endpoint": { "enum": ["local", "commit", "push", "draft_pr", "ready_pr", null] },
        "wording": { "$ref": "#/$defs/NonEmptyText" },
        "source": { "$ref": "#/$defs/NonEmptyText" },
        "at": { "$ref": "#/$defs/Timestamp" },
        "additional_cycles": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/PositiveInteger" }] }
      }
    },
    "AuthorizationObject": {
      "type": "object",
      "required": ["endpoint", "merge", "monitoring", "notes", "repo_overrides", "grants"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/Endpoint" },
        "merge": { "type": "boolean" },
        "monitoring": { "enum": ["none", "observe", "remediate"] },
        "notes": { "$ref": "#/$defs/Text" },
        "repo_overrides": { "$ref": "#/$defs/StringArray" },
        "grants": { "type": "array", "items": { "$ref": "#/$defs/Grant" } }
      }
    },
    "GitHubRepository": {
      "type": "object",
      "required": ["host", "owner", "name"],
      "properties": { "host": { "$ref": "#/$defs/NonEmptyText" }, "owner": { "$ref": "#/$defs/NonEmptyText" }, "name": { "$ref": "#/$defs/NonEmptyText" } }
    },
    "Repo": {
      "type": "object",
      "required": ["path", "common_git_dir", "remote_name", "remote_url", "github", "base_ref", "base_oid", "diff_base_oid"],
      "properties": {
        "path": { "$ref": "#/$defs/AbsolutePath" },
        "common_git_dir": { "$ref": "#/$defs/AbsolutePath" },
        "remote_name": { "type": ["string", "null"], "minLength": 1 },
        "remote_url": { "type": ["string", "null"], "minLength": 1 },
        "github": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/GitHubRepository" }] },
        "base_ref": { "$ref": "#/$defs/NonEmptyText" },
        "base_oid": { "$ref": "#/$defs/OID" },
        "diff_base_oid": { "$ref": "#/$defs/OID" }
      }
    },
    "Owner": {
      "type": "object",
      "required": ["runtime", "session", "model", "phase", "claim_id", "claimed_at"],
      "properties": {
        "runtime": { "$ref": "#/$defs/Runtime" },
        "session": { "$ref": "#/$defs/NonEmptyText" },
        "model": { "$ref": "#/$defs/NullableText" },
        "phase": { "$ref": "#/$defs/SessionPhase" },
        "claim_id": { "$ref": "#/$defs/Uuid" },
        "claimed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Next": {
      "type": "object",
      "required": ["phase", "checkpoint", "suggested_runtime", "brief", "inputs", "authorization_required"],
      "properties": {
        "phase": { "$ref": "#/$defs/SessionPhase" },
        "checkpoint": { "$ref": "#/$defs/Checkpoint" },
        "suggested_runtime": { "$ref": "#/$defs/NullableRuntime" },
        "brief": { "$ref": "#/$defs/Text" },
        "inputs": { "$ref": "#/$defs/SourceArray" },
        "authorization_required": { "type": "boolean" }
      }
    },
    "Blocker": {
      "type": "object",
      "required": ["reason", "resume_phase", "resume_checkpoint", "required_action"],
      "properties": {
        "reason": { "$ref": "#/$defs/NonEmptyText" },
        "resume_phase": { "$ref": "#/$defs/SessionPhase" },
        "resume_checkpoint": { "$ref": "#/$defs/Checkpoint" },
        "required_action": { "$ref": "#/$defs/NonEmptyText" }
      }
    },
    "Completion": {
      "type": "object",
      "required": ["endpoint", "reached_at", "candidate_oid", "content_id", "content_manifest", "evidence_ids", "limitations"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/Endpoint" },
        "reached_at": { "$ref": "#/$defs/Timestamp" },
        "candidate_oid": { "$ref": "#/$defs/NullableOID" },
        "content_id": { "$ref": "#/$defs/NullableContentId" },
        "content_manifest": { "$ref": "#/$defs/NullableSource" },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/QualifiedRef" } },
        "limitations": { "$ref": "#/$defs/StringArray" }
      }
    },
    "Policy": {
      "type": "object",
      "required": ["skill_pack_oid", "skill_sources", "session_mode"],
      "properties": {
        "skill_pack_oid": { "$ref": "#/$defs/NullableOID" },
        "skill_sources": { "$ref": "#/$defs/SourceArray" },
        "session_mode": { "enum": ["fresh", "same_session"] }
      }
    },
    "Dependency": {
      "type": "object",
      "required": ["name", "path", "oid", "build_hash", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/Id" },
        "path": { "$ref": "#/$defs/AbsolutePath" },
        "oid": { "$ref": "#/$defs/OID" },
        "build_hash": { "$ref": "#/$defs/NullableSHA256" },
        "evidence": { "$ref": "#/$defs/NonEmptyText" }
      }
    },
    "RemoteBaseline": {
      "type": "object",
      "required": ["remote_name", "ref", "oid", "observed_at"],
      "properties": {
        "remote_name": { "$ref": "#/$defs/NonEmptyText" },
        "ref": { "type": "string", "pattern": "^refs/heads/.+$" },
        "oid": { "$ref": "#/$defs/OID" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Candidate": {
      "type": "object",
      "required": ["branch", "worktree", "oid", "previous_oid", "generation", "baseline_oid", "working_head_oid", "recovery_required", "state", "dependencies", "remote_baseline"],
      "properties": {
        "branch": { "$ref": "#/$defs/NonEmptyText" },
        "worktree": { "$ref": "#/$defs/AbsolutePath" },
        "oid": { "$ref": "#/$defs/NullableOID" },
        "previous_oid": { "$ref": "#/$defs/NullableOID" },
        "generation": { "$ref": "#/$defs/Counter" },
        "baseline_oid": { "$ref": "#/$defs/OID" },
        "working_head_oid": { "$ref": "#/$defs/OID" },
        "recovery_required": { "type": "boolean" },
        "state": { "enum": ["working", "frozen"] },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/Dependency" } },
        "remote_baseline": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/RemoteBaseline" }] }
      }
    },
    "AuditPolicy": {
      "type": "object",
      "required": ["required", "state", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "state": { "enum": ["not_requested", "pending", "complete", "blocked"] },
        "reason": { "$ref": "#/$defs/Text" }
      }
    },
    "PR": {
      "type": "object",
      "required": ["host", "repository", "number", "url", "head_branch", "head", "head_repository", "base", "draft", "state", "observed_at"],
      "properties": {
        "host": { "$ref": "#/$defs/NonEmptyText" },
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "number": { "$ref": "#/$defs/PositiveInteger" },
        "url": { "$ref": "#/$defs/NonEmptyText" },
        "head_branch": { "$ref": "#/$defs/NonEmptyText" },
        "head": { "$ref": "#/$defs/OID" },
        "head_repository": { "$ref": "#/$defs/GitHubRepository" },
        "base": { "$ref": "#/$defs/NonEmptyText" },
        "draft": { "type": "boolean" },
        "state": { "enum": ["OPEN", "CLOSED", "MERGED"] },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Measurements": {
      "type": "object",
      "required": [
        "files", "additions", "deletions", "binary_files", "measured_oid", "diff_base_oid", "review_rounds", "post_pr_findings",
        "validation_reruns", "cohort_id", "comparison_delivery_ids", "observation_started_at", "observation_ends_at",
        "observation_complete", "attribution_state", "main_tokens", "total_attributable_tokens", "exclusion_reason"
      ],
      "properties": {
        "files": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Counter" }] },
        "additions": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Counter" }] },
        "deletions": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Counter" }] },
        "binary_files": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Counter" }] },
        "measured_oid": { "$ref": "#/$defs/NullableOID" },
        "diff_base_oid": { "$ref": "#/$defs/NullableOID" },
        "review_rounds": { "$ref": "#/$defs/Counter" },
        "post_pr_findings": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Counter" }] },
        "validation_reruns": { "$ref": "#/$defs/Counter" },
        "cohort_id": { "$ref": "#/$defs/NullableText" },
        "comparison_delivery_ids": { "$ref": "#/$defs/StringArray" },
        "observation_started_at": { "$ref": "#/$defs/NullableTimestamp" },
        "observation_ends_at": { "$ref": "#/$defs/NullableTimestamp" },
        "observation_complete": { "type": "boolean" },
        "attribution_state": { "enum": ["not_enrolled", "complete", "partial", "unavailable"] },
        "main_tokens": { "type": ["number", "null"], "minimum": 0 },
        "total_attributable_tokens": { "type": ["number", "null"], "minimum": 0 },
        "exclusion_reason": { "$ref": "#/$defs/NullableText" }
      }
    },
    "UpdatedBy": {
      "type": "object",
      "required": ["runtime", "model", "session", "at"],
      "properties": {
        "runtime": { "$ref": "#/$defs/Runtime" },
        "model": { "$ref": "#/$defs/NullableText" },
        "session": { "$ref": "#/$defs/NonEmptyText" },
        "at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["id", "source_id", "severity", "shape", "location", "expected", "actual", "evidence", "classification", "disposition", "reason", "fix_oid", "fix_content_id", "fix_content_manifest", "thread_id"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "source_id": { "$ref": "#/$defs/NullableText" },
        "severity": { "$ref": "#/$defs/Severity" },
        "shape": { "$ref": "#/$defs/NullableText" },
        "location": { "$ref": "#/$defs/Text" },
        "expected": { "$ref": "#/$defs/Text" },
        "actual": { "$ref": "#/$defs/Text" },
        "evidence": { "$ref": "#/$defs/StringArray" },
        "classification": { "enum": ["valid", "invalid", "unclear", "out_of_scope", "informational", "duplicate", "already_resolved", null] },
        "disposition": { "enum": ["pending", "fixed", "rejected", "deferred", "duplicate", "already_resolved", "informational"] },
        "reason": { "$ref": "#/$defs/NullableText" },
        "fix_oid": { "$ref": "#/$defs/NullableOID" },
        "fix_content_id": { "$ref": "#/$defs/NullableContentId" },
        "fix_content_manifest": { "$ref": "#/$defs/NullableSource" },
        "thread_id": { "$ref": "#/$defs/NullableText" }
      }
    },
    "ReviewBatch": {
      "type": "object",
      "required": ["id", "path", "sha256", "head", "observed_at", "complete"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "path": { "$ref": "#/$defs/AbsolutePath" },
        "sha256": { "$ref": "#/$defs/SHA256" },
        "head": { "$ref": "#/$defs/OID" },
        "observed_at": { "$ref": "#/$defs/Timestamp" },
        "complete": { "type": "boolean" }
      }
    },
    "Review": {
      "type": "object",
      "required": ["id", "round", "mode", "candidate_oid", "content_id", "content_manifest", "source_hashes", "runtime", "model", "source", "verdict", "report", "findings", "batch", "cycle_id", "cycle_kind", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "round": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Counter" }] },
        "mode": { "enum": ["implementation", "doc", "spec"] },
        "candidate_oid": { "$ref": "#/$defs/NullableOID" },
        "content_id": { "$ref": "#/$defs/NullableContentId" },
        "content_manifest": { "$ref": "#/$defs/NullableSource" },
        "source_hashes": { "$ref": "#/$defs/SourceArray" },
        "runtime": { "$ref": "#/$defs/Runtime" },
        "model": { "$ref": "#/$defs/NullableText" },
        "source": { "enum": ["delegated", "inline", "codex-bot", "human"] },
        "verdict": { "enum": ["accept", "revise", "split", "rewrite", "pass", "pass-with-fixes", "fail"] },
        "report": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/AbsolutePath" }] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "batch": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ReviewBatch" }] },
        "cycle_id": { "$ref": "#/$defs/NullableText" },
        "cycle_kind": { "enum": ["implementation_review", "post_pr_fix", null] },
        "at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Audit": {
      "type": "object",
      "required": ["id", "mode", "runtime", "model", "verdict", "report", "oid", "content_id", "content_manifest", "at", "role_run_id"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "mode": { "enum": ["ui", "api", "a11y"] },
        "runtime": { "$ref": "#/$defs/Runtime" },
        "model": { "$ref": "#/$defs/NullableText" },
        "verdict": { "enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"] },
        "report": { "$ref": "#/$defs/NonEmptyText" },
        "oid": { "$ref": "#/$defs/NullableOID" },
        "content_id": { "$ref": "#/$defs/NullableContentId" },
        "content_manifest": { "$ref": "#/$defs/NullableSource" },
        "at": { "$ref": "#/$defs/Timestamp" },
        "role_run_id": { "$ref": "#/$defs/NullableText" }
      }
    },
    "DefectShape": {
      "type": "object",
      "required": ["id", "shape", "first_seen", "candidate_oid", "sweep", "searched_scope", "siblings_fixed", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "shape": { "$ref": "#/$defs/NonEmptyText" },
        "first_seen": { "$ref": "#/$defs/Timestamp" },
        "candidate_oid": { "$ref": "#/$defs/OID" },
        "sweep": { "enum": ["pending", "done"] },
        "searched_scope": { "$ref": "#/$defs/StringArray" },
        "siblings_fixed": { "$ref": "#/$defs/StringArray" },
        "evidence": { "$ref": "#/$defs/NullableText" }
      }
    },
    "Limitation": {
      "type": "object",
      "required": ["id", "kind", "phase", "reason", "affects", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "kind": { "$ref": "#/$defs/NonEmptyText" },
        "phase": { "enum": ["delivery", "review_round", "watch", "done", "blocked"] },
        "reason": { "$ref": "#/$defs/NonEmptyText" },
        "affects": { "$ref": "#/$defs/StringArray" },
        "at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "HistoryEvent": {
      "type": "object",
      "required": ["id", "revision", "at", "runtime", "session", "phase", "operation", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "revision": { "$ref": "#/$defs/Counter" },
        "at": { "$ref": "#/$defs/Timestamp" },
        "runtime": { "$ref": "#/$defs/NullableText" },
        "session": { "$ref": "#/$defs/NullableText" },
        "phase": { "enum": ["delivery", "review_round", "watch", "done", "blocked"] },
        "operation": { "$ref": "#/$defs/NonEmptyText" },
        "detail": { "type": "object" }
      }
    },
    "Receipt": {
      "type": "object",
      "required": ["path", "sha256", "adapter", "identity"],
      "properties": {
        "path": { "$ref": "#/$defs/AbsolutePath" },
        "sha256": { "$ref": "#/$defs/SHA256" },
        "adapter": { "$ref": "#/$defs/NonEmptyText" },
        "identity": { "type": "object" }
      }
    },
    "Reuse": {
      "type": "object",
      "required": ["source_id", "source_oid", "target_oid", "unchanged_inputs", "reason"],
      "properties": {
        "source_id": { "$ref": "#/$defs/Id" },
        "source_oid": { "$ref": "#/$defs/NullableOID" },
        "target_oid": { "$ref": "#/$defs/NullableOID" },
        "unchanged_inputs": { "$ref": "#/$defs/SourceArray" },
        "reason": { "$ref": "#/$defs/NonEmptyText" }
      }
    },
    "Validation": {
      "type": "object",
      "required": ["id", "kind", "command", "cwd", "scope", "oid", "content_id", "content_manifest", "result", "exit_code", "at", "log", "receipt", "reason", "reused_from", "input_fingerprint", "reuse"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "kind": { "enum": ["command", "receipt"] },
        "command": { "$ref": "#/$defs/NullableText" },
        "cwd": { "$ref": "#/$defs/AbsolutePath" },
        "scope": { "enum": ["focused", "gate"] },
        "oid": { "$ref": "#/$defs/NullableOID" },
        "content_id": { "$ref": "#/$defs/NullableContentId" },
        "content_manifest": { "$ref": "#/$defs/NullableSource" },
        "result": { "enum": ["pass", "fail", "skipped", "unavailable", "pending"] },
        "exit_code": { "type": ["integer", "null"] },
        "at": { "$ref": "#/$defs/Timestamp" },
        "log": { "$ref": "#/$defs/NullableText" },
        "receipt": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Receipt" }] },
        "reason": { "$ref": "#/$defs/NullableText" },
        "reused_from": { "$ref": "#/$defs/NullableText" },
        "input_fingerprint": { "$ref": "#/$defs/NullableSHA256" },
        "reuse": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Reuse" }] }
      }
    },
    "Precondition": {
      "type": "object",
      "required": ["head_oid", "body_sha256", "state", "observed_at"],
      "properties": {
        "head_oid": { "$ref": "#/$defs/NullableOID" },
        "body_sha256": { "$ref": "#/$defs/NullableSHA256" },
        "state": { "$ref": "#/$defs/NullableText" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Observed": {
      "type": "object",
      "required": ["object_id", "url", "target", "oid", "body_sha256", "draft", "resolved", "state", "observed_at"],
      "properties": {
        "object_id": { "$ref": "#/$defs/NullableText" },
        "url": { "$ref": "#/$defs/NullableText" },
        "target": { "type": "object" },
        "oid": { "$ref": "#/$defs/NullableOID" },
        "body_sha256": { "$ref": "#/$defs/NullableSHA256" },
        "draft": { "type": ["boolean", "null"] },
        "resolved": { "type": ["boolean", "null"] },
        "state": { "$ref": "#/$defs/NullableText" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PushTarget": {
      "type": "object",
      "required": ["remote_name", "remote_url", "ref", "host", "repository"],
      "properties": {
        "remote_name": { "$ref": "#/$defs/NonEmptyText" },
        "remote_url": { "$ref": "#/$defs/NonEmptyText" },
        "ref": { "type": "string", "pattern": "^refs/.+$" },
        "host": { "type": ["string", "null"], "minLength": 1 },
        "repository": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "PushIntended": { "type": "object", "required": ["oid"], "properties": { "oid": { "$ref": "#/$defs/OID" } } },
    "PrCreateTarget": {
      "type": "object",
      "required": ["host", "repository", "pr_number", "pr_url"],
      "properties": {
        "host": { "$ref": "#/$defs/NonEmptyText" },
        "repository": { "$ref": "#/$defs/NonEmptyText" },
        "pr_number": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/PositiveInteger" }] },
        "pr_url": { "$ref": "#/$defs/NullableText" }
      }
    },
    "PrCreateIntended": {
      "type": "object",
      "required": ["head_repository", "head_branch", "base", "draft", "body_file", "body_sha256"],
      "properties": {
        "head_repository": { "$ref": "#/$defs/GitHubRepository" },
        "head_branch": { "$ref": "#/$defs/NonEmptyText" },
        "base": { "$ref": "#/$defs/NonEmptyText" },
        "draft": { "type": "boolean" },
        "body_file": { "$ref": "#/$defs/AbsolutePath" },
        "body_sha256": { "$ref": "#/$defs/SHA256" }
      }
    },
    "PrTarget": {
      "type": "object",
      "required": ["host", "repository", "pr_number", "pr_url"],
      "properties": {
        "host": { "$ref": "#/$defs/NonEmptyText" },
        "repository": { "$ref": "#/$defs/NonEmptyText" },
        "pr_number": { "$ref": "#/$defs/PositiveInteger" },
        "pr_url": { "$ref": "#/$defs/NonEmptyText" }
      }
    },
    "BodyIntended": {
      "type": "object",
      "required": ["body_file", "body_sha256"],
      "properties": { "body_file": { "$ref": "#/$defs/AbsolutePath" }, "body_sha256": { "$ref": "#/$defs/SHA256" } }
    },
    "PrStateIntended": { "type": "object", "required": ["draft"], "properties": { "draft": { "type": "boolean" } } },
    "ReplyTarget": {
      "allOf": [
        { "$ref": "#/$defs/PrTarget" },
        {
          "type": "object",
          "required": ["root_comment_database_id", "thread_graphql_id"],
          "properties": { "root_comment_database_id": { "$ref": "#/$defs/NonEmptyText" }, "thread_graphql_id": { "$ref": "#/$defs/NonEmptyText" } }
        }
      ]
    },
    "ResolveTarget": {
      "allOf": [
        { "$ref": "#/$defs/PrTarget" },
        { "type": "object", "required": ["thread_graphql_id"], "properties": { "thread_graphql_id": { "$ref": "#/$defs/NonEmptyText" } } }
      ]
    },
    "ResolveIntended": {
      "type": "object",
      "required": ["resolved", "reply_operation_id"],
      "properties": { "resolved": { "const": true }, "reply_operation_id": { "$ref": "#/$defs/Id" } }
    },
    "PublicationEvent": {
      "type": "object",
      "required": ["id", "operation_id", "step", "kind", "at", "candidate_oid", "target", "intended", "precondition", "batch_id", "observed", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "operation_id": { "$ref": "#/$defs/Id" },
        "step": { "enum": ["prepared", "verified", "uncertain", "mismatch", "failed"] },
        "kind": { "enum": ["push", "pr_create", "pr_body", "pr_state", "reply", "resolve"] },
        "at": { "$ref": "#/$defs/Timestamp" },
        "candidate_oid": { "$ref": "#/$defs/OID" },
        "target": { "type": "object" },
        "intended": { "type": "object" },
        "precondition": { "$ref": "#/$defs/Precondition" },
        "batch_id": { "$ref": "#/$defs/NullableText" },
        "observed": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Observed" }] },
        "error": { "$ref": "#/$defs/NullableText" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "push" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/PushTarget" }, "intended": { "$ref": "#/$defs/PushIntended" } } } },
        { "if": { "properties": { "kind": { "const": "pr_create" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/PrCreateTarget" }, "intended": { "$ref": "#/$defs/PrCreateIntended" } } } },
        { "if": { "properties": { "kind": { "const": "pr_body" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/PrTarget" }, "intended": { "$ref": "#/$defs/BodyIntended" } } } },
        { "if": { "properties": { "kind": { "const": "pr_state" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/PrTarget" }, "intended": { "$ref": "#/$defs/PrStateIntended" } } } },
        { "if": { "properties": { "kind": { "const": "reply" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/ReplyTarget" }, "intended": { "$ref": "#/$defs/BodyIntended" } } } },
        { "if": { "properties": { "kind": { "const": "resolve" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/ResolveTarget" }, "intended": { "$ref": "#/$defs/ResolveIntended" } } } }
      ]
    },
    "Enforcement": {
      "type": "object",
      "required": ["tools", "filesystem", "github", "delegation"],
      "properties": {
        "tools": { "$ref": "#/$defs/NonEmptyText" },
        "filesystem": { "$ref": "#/$defs/NonEmptyText" },
        "github": { "$ref": "#/$defs/NonEmptyText" },
        "delegation": { "$ref": "#/$defs/NonEmptyText" }
      }
    },
    "RoleRun": {
      "type": "object",
      "required": [
        "id", "role", "mode", "phase", "candidate_oid", "content_id", "content_manifest", "execution", "runtime", "runtime_version",
        "client", "session_label", "native_session_id", "requested_tier", "requested_model", "requested_effort", "observed_model",
        "observed_effort", "config_hash", "enforcement", "status", "block_reason", "fallback_reason", "parent_run_id",
        "result_report", "result_summary", "started_at", "ended_at", "heavy_commands"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "role": { "$ref": "#/$defs/NonEmptyText" },
        "mode": { "$ref": "#/$defs/NonEmptyText" },
        "phase": { "$ref": "#/$defs/SessionPhase" },
        "candidate_oid": { "$ref": "#/$defs/NullableOID" },
        "content_id": { "$ref": "#/$defs/NullableContentId" },
        "content_manifest": { "$ref": "#/$defs/NullableSource" },
        "execution": { "enum": ["delegated", "inline"] },
        "runtime": { "$ref": "#/$defs/Runtime" },
        "runtime_version": { "$ref": "#/$defs/NonEmptyText" },
        "client": { "$ref": "#/$defs/NonEmptyText" },
        "session_label": { "$ref": "#/$defs/NonEmptyText" },
        "native_session_id": { "$ref": "#/$defs/NullableText" },
        "requested_tier": { "$ref": "#/$defs/NonEmptyText" },
        "requested_model": { "$ref": "#/$defs/NullableText" },
        "requested_effort": { "$ref": "#/$defs/NullableText" },
        "observed_model": { "$ref": "#/$defs/NullableText" },
        "observed_effort": { "$ref": "#/$defs/NullableText" },
        "config_hash": { "$ref": "#/$defs/NullableText" },
        "enforcement": { "$ref": "#/$defs/Enforcement" },
        "status": { "enum": ["queued", "running", "complete", "blocked", "partial", "error", "cancelled"] },
        "block_reason": { "$ref": "#/$defs/NullableText" },
        "fallback_reason": { "$ref": "#/$defs/NullableText" },
        "parent_run_id": { "$ref": "#/$defs/NullableText" },
        "result_report": { "$ref": "#/$defs/NullableText" },
        "result_summary": { "$ref": "#/$defs/Text" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "ended_at": { "$ref": "#/$defs/NullableTimestamp" },
        "heavy_commands": { "type": "array", "items": { "type": "object" } }
      }
    },
    "Session": {
      "type": "object",
      "required": ["id", "label", "runtime", "runtime_version", "client", "native_session_id", "phase", "started_at", "ended_at", "transcript_ref", "parent_session_id", "measurement_state"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "supersedes_id": { "$ref": "#/$defs/NullableText" },
        "label": { "$ref": "#/$defs/NonEmptyText" },
        "runtime": { "$ref": "#/$defs/Runtime" },
        "runtime_version": { "$ref": "#/$defs/NonEmptyText" },
        "client": { "$ref": "#/$defs/NonEmptyText" },
        "native_session_id": { "$ref": "#/$defs/NullableText" },
        "phase": { "$ref": "#/$defs/SessionPhase" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "ended_at": { "$ref": "#/$defs/NullableTimestamp" },
        "transcript_ref": { "$ref": "#/$defs/NullableText" },
        "parent_session_id": { "$ref": "#/$defs/NullableText" },
        "measurement_state": { "enum": ["complete", "partial", "unavailable"] }
      }
    },
    "ManifestFile": {
      "type": "object",
      "required": ["path", "mode", "state", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["100644", "100755", "120000"] },
        "state": { "enum": ["present", "deleted"] },
        "sha256": { "$ref": "#/$defs/NullableSHA256" }
      }
    },
    "ContentManifest": {
      "type": "object",
      "required": ["version", "baseline_oid", "files", "excluded_paths", "inputs"],
      "properties": {
        "version": { "const": 1 },
        "baseline_oid": { "$ref": "#/$defs/OID" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/ManifestFile" } },
        "excluded_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "inputs": {
          "type": "array",
          "items": { "type": "object", "required": ["name", "value"], "properties": { "name": { "$ref": "#/$defs/NonEmptyText" }, "value": { "type": "string" } } }
        }
      }
    },
    "BootstrapInput": {
      "type": "object",
      "required": ["brief", "instructions", "decisions", "spec_check", "policy", "dependencies", "remote_name", "github", "pr", "remote_baseline", "audit_policy"],
      "properties": {
        "brief": { "$ref": "#/$defs/Text" },
        "instructions": { "$ref": "#/$defs/SourceArray" },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/Decision" } },
        "spec_check": { "$ref": "#/$defs/SpecCheck" },
        "policy": { "$ref": "#/$defs/Policy" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/Dependency" } },
        "remote_name": { "type": ["string", "null"], "minLength": 1 },
        "github": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/GitHubRepository" }] },
        "pr": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/PR" }] },
        "remote_baseline": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/RemoteBaseline" }] },
        "audit_policy": { "$ref": "#/$defs/AuditPolicy" }
      }
    },
    "ReleaseInput": {
      "type": "object",
      "required": ["next", "completion", "blocker"],
      "properties": {
        "next": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Next" }] },
        "completion": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Completion" }] },
        "blocker": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Blocker" }] }
      }
    },
    "CommitEvidence": {
      "type": "object",
      "required": ["prior_head", "reason", "source", "intended_paths", "excluded_paths"],
      "properties": {
        "prior_head": { "$ref": "#/$defs/OID" },
        "reason": { "$ref": "#/$defs/NonEmptyText" },
        "source": { "$ref": "#/$defs/NonEmptyText" },
        "intended_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excluded_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ReconcileEvidence": {
      "type": "object",
      "required": ["case", "reason", "source", "grant_id", "expected", "observed", "evidence_paths"],
      "properties": {
        "case": { "enum": ["interrupted_commit", "interrupted_push", "remote_adoption", "source_refresh", "dependency_refresh"] },
        "reason": { "$ref": "#/$defs/NonEmptyText" },
        "source": { "$ref": "#/$defs/NonEmptyText" },
        "grant_id": { "$ref": "#/$defs/NullableText" },
        "expected": {
          "type": "object",
          "required": ["candidate_oid", "working_head_oid"],
          "properties": { "candidate_oid": { "$ref": "#/$defs/NullableOID" }, "working_head_oid": { "$ref": "#/$defs/OID" } }
        },
        "observed": { "type": "object" },
        "evidence_paths": { "type": "array", "items": { "$ref": "#/$defs/AbsolutePath" } }
      }
    }
  }
}
